+def _smooth_calibration_error_raw(labels, preds):
+    # type: (np.array, np.array) -> float
+    """Raw (unnormalized) smooth calibration error, smCE [KF08]_.
+
+    Computes ``sup_f sum_t f(p_t) * (x_t - p_t)`` over all 1-Lipschitz
+    functions f : [0, 1] -> [-1, 1] exactly, via a linear program. The
+    objective only sees f at the sample predictions, so the supremum reduces
+    to choosing values v_i = f(p_i) with |v_i - v_j| <= |p_i - p_j| (only
+    adjacent pairs are needed once predictions are sorted; the rest follow
+    by the triangle inequality) and |v_i| <= 1. Any such values extend to an
+    admissible f (McShane extension of the sample values, clipped to
+    [-1, 1], which preserves 1-Lipschitzness), so the LP optimum equals the
+    true supremum.
+
+    .. [KF08] Kleinberg, J., Mullainathan, S., & Raghavan, M. (2016).
+       Inherent Trade-Offs in the Fair Determination of Risk Scores.
+       arXiv preprint arXiv:1609.05807. https://arxiv.org/abs/1609.05807
+    """
+    labels = np.asarray(labels, dtype=float).ravel()
+    preds = np.asarray(preds, dtype=float).ravel()
+    if labels.shape != preds.shape:
+        raise ValueError("labels and preds must have the same length")
+    n = labels.shape[0]
+    if n == 0:
+        return 0.0
+    residuals = labels - preds
+    order = np.argsort(preds, kind="mergesort")
+    p = preds[order]
+    r = residuals[order]
+    if n == 1:
+        return float(abs(r[0]))
+    # maximize r^T v  <=>  minimize (-r)^T v
+    c = -r
+    bounds = [(-1.0, 1.0)] * n
+    gaps = np.diff(p)  # >= 0 after sorting
+    m = n - 1
+    # |v_i - v_{i+1}| <= gaps_i  <=>
+    # v_i - v_{i+1} <= gaps_i and v_{i+1} - v_i <= gaps_i
+    A_ub = np.zeros((2 * m, n))
+    b_ub = np.zeros(2 * m)
+    idx = np.arange(m)
+    A_ub[idx, idx] = 1.0
+    A_ub[idx, idx + 1] = -1.0
+    A_ub[m + idx, idx] = -1.0
+    A_ub[m + idx, idx + 1] = 1.0
+    b_ub[:m] = gaps
+    b_ub[m:] = gaps
+    res = linprog(c, A_ub=A_ub, b_ub=b_ub, bounds=bounds, method="highs")
+    if not res.success:
+        raise RuntimeError(
+            "smCE linear program failed to converge: %s" % res.message
+        )
+    return float(max(0.0, -res.fun))
+
+
+def subsampled_smooth_calibration_error(labels, preds, n_draws=100, random_state=None):
+    # type: (np.array, np.array, int, object) -> float
+    """Subsampled Smooth Calibration Error (SSCE) [2]_.
+
+    A calibration metric introduced by Haghtalab et al. (2024): the expected
+    smooth calibration error over uniformly random subsets of the data,
+
+        SSCE(x, p) = E_{S ~ Unif(2^[T])}[ smCE(x|_S, p|_S) ],
+
+    where smCE is the supremum, over 1-Lipschitz f : [0, 1] -> [-1, 1], of
+    ``sum_t f(p_t) * (x_t - p_t)``. The paper's headline result is that SSCE
+    is (approximately) truthful: a forecaster (approximately) minimizes the
+    expected penalty by predicting the conditional expectation of each
+    outcome, unlike ECE-style measures which reward strategic misreporting.
+
+    The expectation over all 2^T subsets is estimated by Monte Carlo with
+    ``n_draws`` Bernoulli(1/2) masks. The raw paper-scale value lies in
+    [0, T/2]; this implementation rescales by 2/T so the metric lies in
+    [0, 1], comparable with ECE.
+
+    Parameters
+    ----------
+    labels : array-like of shape (n_samples,)
+        True binary labels (0 or 1).
+    preds : array-like of shape (n_samples,)
+        Predicted probabilities in [0, 1].
+    n_draws : int, default=100
+        Number of random subsets used for the Monte Carlo estimate of the
+        subsampling expectation.
+    random_state : int, RandomState or Generator, optional
+        Seed or generator for the subset masks (reproducibility).
+
+    Returns
+    -------
+    ssce : float
+        Subsampled Smooth Calibration Error in [0, 1]; 0 is perfectly
+        calibrated.
+
+    Examples
+    --------
+    >>> import numpy as np
+    >>> from splinator import subsampled_smooth_calibration_error
+    >>> labels = np.array([0, 0, 1, 1])
+    >>> preds = np.array([0.2, 0.3, 0.7, 0.8])
+    >>> err = subsampled_smooth_calibration_error(labels, preds,
+    ...                                           n_draws=500, random_state=0)
+    >>> 0.0 <= err <= 1.0
+    True
+
+    References
+    ----------
+    .. [2] Haghtalab, N., Qiao, M., Yang, K., & Zhao, E. (2024). Truthfulness
+           of Calibration Measures. arXiv preprint arXiv:2407.13979.
+           https://arxiv.org/abs/2407.13979
+    """
+    labels = np.asarray(labels, dtype=float).ravel()
+    preds = np.asarray(preds, dtype=float).ravel()
+    if labels.shape != preds.shape:
+        raise ValueError("labels and preds must have the same length")
+    n = labels.shape[0]
+    if n == 0:
+        return 0.0
+    rng = np.random.default_rng(random_state)
+    total = 0.0
+    for _ in range(int(n_draws)):
+        mask = rng.random(n) < 0.5
+        total += _smooth_calibration_error_raw(labels[mask], preds[mask])
+    # Paper-scale E[smCE] lies in [0, T/2]; rescale to [0, 1].
+    return float(total / float(n_draws) / (n / 2.0))
